+def _maybe_refresh_sackmann_on_startup(cache_dir: Path) -> None:
+    """If Sackmann cache stale, refresh CSVs + rebuild tennis_ratings.json.
+
+    Runs synchronously before agent loop starts. Heavy on first stale boot
+    (~1-2 min total: download ~25 CSVs + Glicko rebuild over ~70K matches),
+    but skipped entirely when cache is fresh (<3 days old).
+
+    Without this hook, a long-stopped bot would resume on stale ratings and
+    silently miss currently-active players whose form data falls outside the
+    90-day tier-B window (2026-05-27 root cause: Trevor Svajda not in cache).
+    """
+    if not is_cache_stale(cache_dir):
+        logger.info("Sackmann cache is fresh — skipping startup refresh")
+        return
+    logger.info("Sackmann cache is stale — refreshing before agent start")
+    refreshed = refresh_if_stale(cache_dir)
+    if not refreshed:
+        logger.warning("Sackmann refresh attempted but no files downloaded")
+        return
+    logger.info("Rebuilding tennis_ratings.json from refreshed CSVs...")
+    from scripts.build_tennis_ratings import main as rebuild_main  # noqa: PLC0415
+    rebuild_main()
+    logger.info("Startup Sackmann refresh + rebuild complete")
+
 
