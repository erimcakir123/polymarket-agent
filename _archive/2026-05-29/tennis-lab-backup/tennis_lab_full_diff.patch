+def _spawn_detached(cmd: list[str], cwd: Path, label: str, stderr_log: Path) -> None:
+    """Detach launch + stderr capture + 1.5s alive verify.
+
+    Without stderr+verify, DETACHED_PROCESS swallows crashes silently and the
+    user sees "started" while the child is already dead.
+    """
+    stderr_log.parent.mkdir(parents=True, exist_ok=True)
+    fh = open(stderr_log, "a", encoding="utf-8")
+    flags = subprocess.DETACHED_PROCESS | subprocess.CREATE_NO_WINDOW if sys.platform == "win32" else 0
+    kwargs = {"start_new_session": True} if sys.platform != "win32" else {"creationflags": flags}
+    proc = subprocess.Popen(cmd, cwd=str(cwd), stdout=subprocess.DEVNULL, stderr=fh, **kwargs)
+    time.sleep(1.5)
+    if proc.poll() is None:
+        print(f"  {label} started (PID {proc.pid})")
+    else:
+        print(f"  {label} DIED on launch (exit={proc.returncode}) — check {stderr_log}")
+
